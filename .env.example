# Public canonical origin used by Next.js Metadata API.
# Example: https://novesso.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-api-key

# Enquiry emails (contact form + consultation modal) — sent via Resend.
# RESEND_API_KEY:     create at https://resend.com/api-keys
# ENQUIRY_TO_EMAIL:   inbox that receives enquiries (e.g. studio@novesso.com)
# ENQUIRY_FROM_EMAIL: a VERIFIED Resend sender on your domain
#                     (format: "Novesso <enquiries@novesso.com>")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
ENQUIRY_TO_EMAIL=studio@novesso.com
ENQUIRY_FROM_EMAIL=Novesso <enquiries@novesso.com>
